  createdBy     User             @relation("UserCreatedCreditNotes", fields: [createdById], references: [id], onDelete: Restrict)
  sourceInvoice SalesInvoice?    @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines         CreditNoteLine[]

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@index([customerId])
}

model CreditNoteLine {
  id            String   @id @default(cuid())
  creditNoteId  String
  productId     String?
  serviceId     String?
  description   String
  quantity      Decimal  @db.Decimal(15, 4)
  unitOfMeasure String?
  unitPrice     Decimal  @db.Decimal(15, 2)
  taxRate       Float    @default(0)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal      Decimal  @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  service    Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
}


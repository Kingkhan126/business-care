// ============================================================================
// PRISMA SCHEMA: BUSINESS MANAGEMENT & ACCOUNTING PLATFORM (PHASE 4 SCOPE)
// Multi-Tenant Architecture, Settings, Invitations, RBAC, Master Data,
// Inventory & Sales/Purchasing Transaction Engine Foundation
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum AdjustmentType {
  INITIAL_STOCK
  CORRECTION
  DAMAGE
  LOSS
  FOUND
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum CustomerPaymentStatus {
  COMPLETED
  VOID
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum BillStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum VendorPaymentStatus {
  COMPLETED
  VOID
}

enum VendorCreditStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

enum ExpenseType {
  DIRECT_BUSINESS
  EMPLOYEE_CLAIM
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  PAID
  VOIDED
  CANCELLED
}

enum ExpensePaymentType {
  PAID_IMMEDIATELY
  ON_ACCOUNT
  REIMBURSEMENT
}

// ----------------------------------------------------------------------------
// USER IDENTITIES
// ----------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships             OrganizationMember[]
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")
  createdInvitations      OrganizationInvitation[] @relation("UserCreatedInvitations")
  createdStockAdjustments StockAdjustment[]        @relation("UserCreatedStockAdjustments")
  createdEstimates        Estimate[]               @relation("UserCreatedEstimates")
  createdSalesOrders      SalesOrder[]             @relation("UserCreatedSalesOrders")
  createdInvoices         SalesInvoice[]           @relation("UserCreatedInvoices")
  createdCustomerPayments CustomerPayment[]        @relation("UserCreatedCustomerPayments")
  createdCreditNotes      CreditNote[]             @relation("UserCreatedCreditNotes")
  createdPurchaseOrders   PurchaseOrder[]          @relation("UserCreatedPurchaseOrders")
  createdVendorBills      VendorBill[]             @relation("UserCreatedVendorBills")
  createdVendorPayments   VendorPayment[]          @relation("UserCreatedVendorPayments")
  createdVendorCredits    VendorCredit[]           @relation("UserCreatedVendorCredits")
  createdJournalEntries   JournalEntry[]           @relation("UserCreatedJournals")
  createdBankTransfers    BankTransfer[]           @relation("UserCreatedBankTransfers")
  createdExpenses         Expense[]                @relation("UserCreatedExpenses")
  claimedExpenses         Expense[]                @relation("UserClaimedExpenses")
  approvedExpenses        Expense[]                @relation("UserApprovedExpenses")
  uploadedExpenseAttachments ExpenseAttachment[]   @relation("UserUploadedAttachments")

  @@index([email])
}

// ----------------------------------------------------------------------------
// MULTI-TENANT ORGANIZATIONS
// ----------------------------------------------------------------------------

model Organization {
  id                  String   @id @default(cuid())
  name                String
  legalName           String?
  description         String?
  registrationNumber  String?
  taxId               String?
  email               String?
  phone               String?
  website             String?
  logoUrl             String?
  currency            String   @default("USD")
  timezone            String   @default("UTC")
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String   @default("US")
  fiscalYearStart     Int      @default(1) // 1 = January
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members           OrganizationMember[]
  roles             Role[]
  auditLogs         AuditLog[]
  settings          OrganizationSettings?
  invitations       OrganizationInvitation[]
  customers         Customer[]
  suppliers         Supplier[]
  productCategories ProductCategory[]
  unitsOfMeasure    UnitOfMeasure[]
  products          Product[]
  services          Service[]
  warehouses        Warehouse[]
  inventoryItems    InventoryItem[]
  stockAdjustments  StockAdjustment[]
  estimates         Estimate[]
  salesOrders       SalesOrder[]
  invoices          SalesInvoice[]
  customerPayments  CustomerPayment[]
  creditNotes       CreditNote[]
  purchaseOrders    PurchaseOrder[]
  vendorBills       VendorBill[]
  vendorPayments    VendorPayment[]
  vendorCredits     VendorCredit[]
  accounts          Account[]
  accountMappings   AccountMapping[]
  accountingPeriods   AccountingPeriod[]
  journalEntries      JournalEntry[]
  accountingEvents    AccountingEvent[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  bankTransfers       BankTransfer[]
  bankReconciliations BankReconciliation[]
  bankImportBatches   BankImportBatch[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  expenseAttachments  ExpenseAttachment[]

  @@index([name])
}

// ----------------------------------------------------------------------------
// ORGANIZATION SETTINGS FOUNDATION
// ----------------------------------------------------------------------------

model OrganizationSettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  dateFormat              String   @default("YYYY-MM-DD")
  timeFormat              String   @default("24h")
  numberFormat            String   @default("comma_dot") // 1,234.56 vs 1.234,56
  taxInclusivePricing     Boolean  @default(false)
  taxRegistrationNumber   String?
  defaultTaxRate          Float    @default(0.0)
  invoicePrefix           String   @default("INV-")
  estimatePrefix          String   @default("EST-")
  salesOrderPrefix        String   @default("SO-")
  purchaseOrderPrefix     String   @default("PO-")
  billPrefix              String   @default("BILL-")
  creditNotePrefix        String   @default("CN-")
  vendorCreditPrefix      String   @default("VC-")
  paymentPrefix           String   @default("PAY-")
  vendorPaymentPrefix     String   @default("VPAY-")
  expensePrefix           String   @default("EXP-")
  nextInvoiceNumber       Int      @default(1001)
  nextEstimateNumber      Int      @default(1001)
  nextSalesOrderNumber    Int      @default(1001)
  nextPurchaseOrderNumber Int      @default(1001)
  nextBillNumber          Int      @default(1001)
  nextCreditNoteNumber    Int      @default(1001)
  nextVendorCreditNumber  Int      @default(1001)
  nextPaymentNumber       Int      @default(1001)
  nextVendorPaymentNumber Int      @default(1001)
  nextExpenseNumber       Int      @default(1001)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// ORGANIZATION INVITATIONS SYSTEM
// ----------------------------------------------------------------------------

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdById    String
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("UserCreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@index([email])
}

// ----------------------------------------------------------------------------
// ORGANIZATION MEMBERSHIP & ROLES
// ----------------------------------------------------------------------------

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String? // null for system-wide default roles
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  permissions  RolePermission[]
  invitations  OrganizationInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "customers.read", "invoices.create"
  category    String // e.g., "Sales", "Purchases", "Organization"
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([code])
  @@index([category])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ----------------------------------------------------------------------------
// AUDIT LOGGING FOUNDATION
// ----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String // e.g., "user.login", "invoice.created"
  entityType     String? // e.g., "Organization", "SalesInvoice"
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// MASTER DATA MODELS
// ----------------------------------------------------------------------------

model Customer {
  id                   String         @id @default(cuid())
  organizationId       String
  customerNumber       String
  displayName          String
  legalName            String?
  contactPerson        String?
  email                String?
  phone                String?
  alternatePhone       String?
  website              String?
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingCity          String?
  billingState         String?
  billingPostalCode    String?
  billingCountry       String?        @default("US")
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?        @default("US")
  taxId                String?
  registrationNumber   String?
  currency             String         @default("USD")
  paymentTerms         String?
  creditLimit          Decimal?       @db.Decimal(15, 2)
  notes                String?
  status               CustomerStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estimates    Estimate[]
  salesOrders  SalesOrder[]
  invoices     SalesInvoice[]
  payments     CustomerPayment[]
  creditNotes  CreditNote[]
  journalLines JournalEntryLine[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId])
  @@index([displayName])
  @@index([email])
}

model Supplier {
  id                 String         @id @default(cuid())
  organizationId     String
  supplierNumber     String
  displayName        String
  legalName          String?
  contactPerson      String?
  email              String?
  phone              String?
  alternatePhone     String?
  website            String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?        @default("US")
  taxId              String?
  registrationNumber String?
  currency           String         @default("USD")
  paymentTerms       String?
  notes              String?
  status             SupplierStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  payments       VendorPayment[]
  vendorCredits  VendorCredit[]
  journalLines   JournalEntryLine[]
  expenses       Expense[]

  @@unique([organizationId, supplierNumber])
  @@index([organizationId])
  @@index([displayName])
  @@index([email])
}

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     ProductCategory[] @relation("CategoryHierarchy")
  products     Product[]
  services     Service[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model UnitOfMeasure {
  id             String   @id @default(cuid())
  organizationId String? // null for system standard units
  code           String
  name           String
  symbol         String
  precision      Int      @default(0)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  services     Service[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Product {
  id                 String        @id @default(cuid())
  organizationId     String
  sku                String
  name               String
  description        String?
  categoryId         String?
  unitOfMeasureId    String?
  barcode            String?
  brand              String?
  trackInventory     Boolean       @default(true)
  allowNegativeStock Boolean       @default(false)
  reorderLevel       Decimal?      @db.Decimal(15, 4)
  reorderQuantity    Decimal?      @db.Decimal(15, 4)
  costPrice          Decimal       @default(0) @db.Decimal(15, 2)
  sellingPrice       Decimal       @default(0) @db.Decimal(15, 2)
  currency           String        @default("USD")
  status             ProductStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitOfMeasure      UnitOfMeasure?      @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull)
  inventoryItems     InventoryItem[]
  stockAdjustments   StockAdjustment[]
  estimateLines      EstimateLine[]
  salesOrderLines    SalesOrderLine[]
  invoiceLines       InvoiceLine[]
  creditNoteLines    CreditNoteLine[]
  purchaseOrderLines PurchaseOrderLine[]
  vendorBillLines    VendorBillLine[]
  vendorCreditLines  VendorCreditLine[]
  journalLines       JournalEntryLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([name])
  @@index([barcode])
}

model Service {
  id              String        @id @default(cuid())
  organizationId  String
  code            String
  name            String
  description     String?
  categoryId      String?
  unitOfMeasureId String?
  costPrice       Decimal       @default(0) @db.Decimal(15, 2)
  sellingPrice    Decimal       @default(0) @db.Decimal(15, 2)
  currency        String        @default("USD")
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitOfMeasure      UnitOfMeasure?      @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull)
  estimateLines      EstimateLine[]
  salesOrderLines    SalesOrderLine[]
  invoiceLines       InvoiceLine[]
  creditNoteLines    CreditNoteLine[]
  purchaseOrderLines PurchaseOrderLine[]
  vendorBillLines    VendorBillLine[]
  vendorCreditLines  VendorCreditLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([name])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  addressLine1   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?  @default("US")
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems   InventoryItem[]
  stockAdjustments StockAdjustment[]
  invoices         SalesInvoice[]
  creditNotes      CreditNote[]
  vendorBills      VendorBill[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String
  productId      String
  quantity       Decimal  @default(0) @db.Decimal(15, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
}

model StockAdjustment {
  id               String         @id @default(cuid())
  organizationId   String
  warehouseId      String
  productId        String
  adjustmentType   AdjustmentType
  quantityChange   Decimal        @db.Decimal(15, 4)
  previousQuantity Decimal        @db.Decimal(15, 4)
  newQuantity      Decimal        @db.Decimal(15, 4)
  reason           String
  notes            String?
  createdById      String
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("UserCreatedStockAdjustments", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// PHASE 4: SALES TRANSACTION MODELS
// ----------------------------------------------------------------------------

model Estimate {
  id                    String         @id @default(cuid())
  organizationId        String
  estimateNumber        String
  customerId            String
  issueDate             DateTime
  expiryDate            DateTime?
  status                EstimateStatus @default(DRAFT)
  currency              String         @default("USD")
  subtotal              Decimal        @default(0) @db.Decimal(15, 2)
  discountTotal         Decimal        @default(0) @db.Decimal(15, 2)
  taxTotal              Decimal        @default(0) @db.Decimal(15, 2)
  total                 Decimal        @default(0) @db.Decimal(15, 2)
  notes                 String?
  terms                 String?
  convertedSalesOrderId String?        @unique
  createdById           String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("UserCreatedEstimates", fields: [createdById], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder?   @relation("EstimateToSalesOrder", fields: [convertedSalesOrderId], references: [id], onDelete: SetNull)
  lines        EstimateLine[]

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}

model EstimateLine {
  id            String   @id @default(cuid())
  estimateId    String
  productId     String?
  serviceId     String?
  description   String
  quantity      Decimal  @db.Decimal(15, 4)
  unitOfMeasure String?
  unitPrice     Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  taxRate       Float    @default(0)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal      Decimal  @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

model SalesOrder {
  id                   String           @id @default(cuid())
  organizationId       String
  orderNumber          String
  customerId           String
  sourceEstimateId     String?
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               SalesOrderStatus @default(DRAFT)
  currency             String           @default("USD")
  subtotal             Decimal          @default(0) @db.Decimal(15, 2)
  discountTotal        Decimal          @default(0) @db.Decimal(15, 2)
  taxTotal             Decimal          @default(0) @db.Decimal(15, 2)
  total                Decimal          @default(0) @db.Decimal(15, 2)
  notes                String?
  terms                String?
  createdById          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy      User             @relation("UserCreatedSalesOrders", fields: [createdById], references: [id], onDelete: Restrict)
  sourceEstimate Estimate?        @relation("EstimateToSalesOrder")
  lines          SalesOrderLine[]
  invoices       SalesInvoice[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}

model SalesOrderLine {
  id            String   @id @default(cuid())
  salesOrderId  String
  productId     String?
  serviceId     String?
  description   String
  quantity      Decimal  @db.Decimal(15, 4)
  unitOfMeasure String?
  unitPrice     Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  taxRate       Float    @default(0)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal      Decimal  @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  service    Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
}

model SalesInvoice {
  id                 String        @id @default(cuid())
  organizationId     String
  invoiceNumber      String
  customerId         String
  sourceSalesOrderId String?
  warehouseId        String?
  issueDate          DateTime
  dueDate            DateTime
  status             InvoiceStatus @default(DRAFT)
  currency           String        @default("USD")
  subtotal           Decimal       @default(0) @db.Decimal(15, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal       @default(0) @db.Decimal(15, 2)
  total              Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(15, 2)
  balanceDue         Decimal       @default(0) @db.Decimal(15, 2)
  notes              String?
  terms              String?
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User                        @relation("UserCreatedInvoices", fields: [createdById], references: [id], onDelete: Restrict)
  sourceSalesOrder   SalesOrder?                 @relation(fields: [sourceSalesOrderId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines              InvoiceLine[]
  paymentAllocations CustomerPaymentAllocation[]
  creditNotes        CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}


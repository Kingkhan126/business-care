model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String?
  serviceId       String?
  description     String
  quantity        Decimal  @db.Decimal(15, 4)
  unitOfMeasure   String?
  unitCost        Decimal  @db.Decimal(15, 2)
  discount        Decimal  @default(0) @db.Decimal(15, 2)
  taxRate         Float    @default(0)
  taxAmount       Decimal  @default(0) @db.Decimal(15, 2)
  subtotal        Decimal  @db.Decimal(15, 2)
  total           Decimal  @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

model VendorBill {
  id                    String        @id @default(cuid())
  organizationId        String
  billNumber            String
  supplierId            String
  sourcePurchaseOrderId String?
  warehouseId           String?
  vendorBillReference   String?
  issueDate             DateTime
  dueDate               DateTime
  status                BillStatus    @default(DRAFT)
  currency              String        @default("USD")
  subtotal              Decimal       @default(0) @db.Decimal(15, 2)
  discountTotal         Decimal       @default(0) @db.Decimal(15, 2)
  taxTotal              Decimal       @default(0) @db.Decimal(15, 2)
  total                 Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid            Decimal       @default(0) @db.Decimal(15, 2)
  balanceDue            Decimal       @default(0) @db.Decimal(15, 2)
  notes                 String?
  terms                 String?
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier            Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy           User                      @relation("UserCreatedVendorBills", fields: [createdById], references: [id], onDelete: Restrict)
  sourcePurchaseOrder PurchaseOrder?            @relation(fields: [sourcePurchaseOrderId], references: [id], onDelete: SetNull)
  warehouse           Warehouse?                @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines               VendorBillLine[]
  paymentAllocations  VendorPaymentAllocation[]
  vendorCredits       VendorCredit[]

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
}

model VendorBillLine {
  id            String   @id @default(cuid())
  billId        String
  productId     String?
  serviceId     String?
  description   String
  quantity      Decimal  @db.Decimal(15, 4)
  unitOfMeasure String?
  unitCost      Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  taxRate       Float    @default(0)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal      Decimal  @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)

  bill    VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([billId])
}

model VendorPayment {
  id                String              @id @default(cuid())
  organizationId    String
  paymentNumber     String
  supplierId        String
  paymentDate       DateTime
  amount            Decimal             @db.Decimal(15, 2)
  unallocatedAmount Decimal             @default(0) @db.Decimal(15, 2)
  currency          String              @default("USD")
  paymentMethod     PaymentMethod       @default(BANK_TRANSFER)
  reference         String?
  notes             String?
  status            VendorPaymentStatus @default(COMPLETED)
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User                      @relation("UserCreatedVendorPayments", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  VendorPaymentAllocation[]
  matchedBankTransactions BankTransaction[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([supplierId])
}

model VendorPaymentAllocation {
  id              String   @id @default(cuid())
  paymentId       String
  billId          String
  allocatedAmount Decimal  @db.Decimal(15, 2)
  allocatedAt     DateTime @default(now())

  payment VendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    VendorBill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
}

model VendorCredit {
  id                 String             @id @default(cuid())
  organizationId     String
  vendorCreditNumber String
  supplierId         String
  sourceBillId       String?
  issueDate          DateTime
  status             VendorCreditStatus @default(DRAFT)
  currency           String             @default("USD")
  subtotal           Decimal            @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal            @default(0) @db.Decimal(15, 2)
  total              Decimal            @default(0) @db.Decimal(15, 2)
  reason             String
  notes              String?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("UserCreatedVendorCredits", fields: [createdById], references: [id], onDelete: Restrict)
  sourceBill   VendorBill?        @relation(fields: [sourceBillId], references: [id], onDelete: SetNull)
  lines        VendorCreditLine[]

  @@unique([organizationId, vendorCreditNumber])
  @@index([organizationId])
  @@index([supplierId])
}

model VendorCreditLine {
  id             String   @id @default(cuid())
  vendorCreditId String
  productId      String?
  serviceId      String?
  description    String
  quantity       Decimal  @db.Decimal(15, 4)
  unitOfMeasure  String?
  unitCost       Decimal  @db.Decimal(15, 2)
  taxRate        Float    @default(0)
  taxAmount      Decimal  @default(0) @db.Decimal(15, 2)
  subtotal       Decimal  @db.Decimal(15, 2)
  total          Decimal  @db.Decimal(15, 2)

  vendorCredit VendorCredit @relation(fields: [vendorCreditId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([vendorCreditId])
}

// ============================================================================
// PHASE 5: GENERAL LEDGER & ACCOUNTING ENGINE MODELS
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
  VOID
}

enum JournalSource {
  MANUAL
  SALES_INVOICE
  CUSTOMER_PAYMENT
  CREDIT_NOTE
  VENDOR_BILL
  VENDOR_PAYMENT
  VENDOR_CREDIT
  STOCK_ADJUSTMENT
  SYSTEM
  BANK_TRANSFER
  BANK_TRANSACTION
  EXPENSE
  EMPLOYEE_REIMBURSEMENT
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum MappingKey {
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  SALES_REVENUE
  SALES_RETURNS
  TAX_PAYABLE
  TAX_RECOVERABLE
  INVENTORY_ASSET
  COST_OF_GOODS_SOLD
  CASH
  BANK
  OWNER_EQUITY
  RETAINED_EARNINGS
  DEFAULT_EXPENSE
  EMPLOYEE_REIMBURSEMENTS_PAYABLE
}

model Account {
  id             String        @id @default(cuid())
  organizationId String
  accountCode    String
  accountName    String
  description    String?
  accountType    AccountType
  normalBalance  NormalBalance
  parentId       String?
  level          Int           @default(1)
  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)
  allowPosting   Boolean       @default(true)
  currency       String        @default("USD")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Account[]          @relation("AccountHierarchy")
  journalLines    JournalEntryLine[]
  accountMappings AccountMapping[]
  bankAccounts    BankAccount[]      @relation("BankAccountToLedgerAccount")
  expenseCategories ExpenseCategory[] @relation("ExpenseCategoryToAccount")

  @@unique([organizationId, accountCode])
  @@index([organizationId])
  @@index([accountType])
  @@index([accountCode])
}

model AccountMapping {
  id             String     @id @default(cuid())
  organizationId String
  mappingKey     MappingKey
  accountId      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, mappingKey])
  @@index([organizationId])
}

model AccountingPeriod {
  id             String       @id @default(cuid())
  organizationId String
  fiscalYear     Int
  periodNumber   Int
  name           String
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([organizationId, fiscalYear, periodNumber])
  @@index([organizationId])
  @@index([status])
}

model JournalEntry {
  id                 String        @id @default(cuid())
  organizationId     String
  journalNumber      String
  entryDate          DateTime
  postingDate        DateTime      @default(now())
  referenceType      String?
  referenceId        String?
  description        String
  source             JournalSource @default(MANUAL)
  status             JournalStatus @default(DRAFT)
  accountingPeriodId String?
  totalDebit         Decimal       @default(0) @db.Decimal(15, 2)
  totalCredit        Decimal       @default(0) @db.Decimal(15, 2)
  createdById        String
  postedById         String?
  postedAt           DateTime?
  reversedEntryId    String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("UserCreatedJournals", fields: [createdById], references: [id], onDelete: Restrict)
  reversedEntry    JournalEntry?     @relation("JournalReversals", fields: [reversedEntryId], references: [id], onDelete: SetNull)
  reversingEntry   JournalEntry?     @relation("JournalReversals")
  lines            JournalEntryLine[]
  matchedBankTransactions BankTransaction[]
  bankTransfers           BankTransfer[]
  expenses                Expense[]        @relation("ExpenseJournalEntry")
  reimbursementExpenses   Expense[]        @relation("ExpenseReimbursementJournal")

  @@unique([organizationId, journalNumber])
  @@index([organizationId])
  @@index([status])
  @@index([entryDate])
  @@index([source])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal  @default(0) @db.Decimal(15, 2)
  credit         Decimal  @default(0) @db.Decimal(15, 2)
  reference      String?
  customerId     String?
  supplierId     String?
  productId      String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@index([accountId])
}

model AccountingEvent {
  id             String   @id @default(cuid())
  organizationId String
  eventType      String
  sourceType     String
  sourceId       String
  journalEntryId String?  @unique
  status         String   @default("PROCESSED")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceType, sourceId, eventType])
  @@index([organizationId])
}

// ============================================================================
// PHASE 6: BANKING & CASH MANAGEMENT ENUMS & MODELS
// ============================================================================

enum BankAccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  MONEY_MARKET
  OTHER
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  FEE
  INTEREST
  ADJUSTMENT
  OTHER
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  VOIDED
}

enum BankTransactionSource {
  MANUAL
  IMPORT
  FEED
}

enum BankTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReconciliationStatus {
  OPEN
  COMPLETED
  VOIDED
}

enum ImportBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

model BankAccount {
  id                    String          @id @default(cuid())
  organizationId        String
  accountName           String
  accountType           BankAccountType @default(CHECKING)
  accountNumberMasked   String?
  routingNumber         String?
  institutionName       String?
  currency              String          @default("USD")
  openingBalance        Decimal         @default(0) @db.Decimal(15, 2)
  openingBalanceDate    DateTime?
  currentBalance        Decimal         @default(0) @db.Decimal(15, 2)
  linkedLedgerAccountId String?
  isActive              Boolean         @default(true)
  description           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedLedgerAccount Account?              @relation("BankAccountToLedgerAccount", fields: [linkedLedgerAccountId], references: [id], onDelete: SetNull)
  transactions        BankTransaction[]
  reconciliations     BankReconciliation[]
  transfersFrom       BankTransfer[]        @relation("TransferFromAccount")
  transfersTo         BankTransfer[]        @relation("TransferToAccount")
  importBatches       BankImportBatch[]
  expenses            Expense[]

  @@unique([organizationId, accountName])
  @@index([organizationId])
  @@index([linkedLedgerAccountId])
  @@index([accountType])
}

model BankTransaction {
  id                       String                @id @default(cuid())
  organizationId           String
  bankAccountId            String
  transactionDate          DateTime
  valueDate                DateTime?
  description              String
  reference                String?
  amount                   Decimal               @db.Decimal(15, 2)
  transactionType          BankTransactionType
  status                   BankTransactionStatus @default(UNMATCHED)
  source                   BankTransactionSource @default(MANUAL)
  payee                    String?
  category                 String?
  memo                     String?
  externalId               String?
  fingerprint              String?
  importBatchId            String?
  matchedCustomerPaymentId String?
  matchedVendorPaymentId   String?
  matchedJournalEntryId    String?
  matchedTransferId        String?
  reconciliationId         String?
  clearedAt                DateTime?
  createdById              String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount            BankAccount             @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  importBatch            BankImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  matchedCustomerPayment CustomerPayment?        @relation(fields: [matchedCustomerPaymentId], references: [id], onDelete: SetNull)
  matchedVendorPayment   VendorPayment?          @relation(fields: [matchedVendorPaymentId], references: [id], onDelete: SetNull)
  matchedJournalEntry    JournalEntry?           @relation(fields: [matchedJournalEntryId], references: [id], onDelete: SetNull)
  reconciliation         BankReconciliation?     @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  reconciliationItems    BankReconciliationItem[]

  @@index([organizationId, bankAccountId, transactionDate])
  @@index([organizationId, status])
  @@unique([organizationId, fingerprint])
  @@index([bankAccountId, status])
  @@index([importBatchId])
}

model BankTransfer {
  id                String             @id @default(cuid())
  organizationId    String
  transferNumber    String
  idempotencyKey    String?
  fromBankAccountId String
  toBankAccountId   String
  amount            Decimal            @db.Decimal(15, 2)
  feeAmount         Decimal            @default(0) @db.Decimal(15, 2)
  transferDate      DateTime
  reference         String?
  memo              String?
  status            BankTransferStatus @default(COMPLETED)
  journalEntryId    String?            @unique
  fromTransactionId String?            @unique
  toTransactionId   String?            @unique
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromBankAccount BankAccount  @relation("TransferFromAccount", fields: [fromBankAccountId], references: [id], onDelete: Restrict)
  toBankAccount   BankAccount  @relation("TransferToAccount", fields: [toBankAccountId], references: [id], onDelete: Restrict)
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User         @relation("UserCreatedBankTransfers", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, transferNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([fromBankAccountId])
  @@index([toBankAccountId])
  @@index([transferDate])
}

model BankReconciliation {
  id                        String               @id @default(cuid())
  organizationId            String
  bankAccountId             String
  reconciliationNumber      String
  statementStartDate        DateTime
  statementEndDate          DateTime
  statementBeginningBalance Decimal              @db.Decimal(15, 2)
  statementEndingBalance    Decimal              @db.Decimal(15, 2)
  reconciledBalance         Decimal              @default(0) @db.Decimal(15, 2)
  difference                Decimal              @default(0) @db.Decimal(15, 2)
  clearedDepositsCount      Int                  @default(0)
  clearedDepositsTotal      Decimal              @default(0) @db.Decimal(15, 2)
  clearedWithdrawalsCount   Int                  @default(0)
  clearedWithdrawalsTotal   Decimal              @default(0) @db.Decimal(15, 2)
  status                    ReconciliationStatus @default(OPEN)
  notes                     String?
  completedAt               DateTime?
  completedById             String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  items        BankReconciliationItem[]
  transactions BankTransaction[]

  @@unique([organizationId, reconciliationNumber])
  @@index([organizationId, bankAccountId])
  @@index([status])
  @@index([statementEndDate])
}

model BankReconciliationItem {
  id                String   @id @default(cuid())
  organizationId    String
  reconciliationId  String
  bankTransactionId String
  isCleared         Boolean  @default(false)
  clearedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reconciliation  BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction    @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, bankTransactionId])
  @@index([organizationId])
  @@index([bankTransactionId])
}

model BankImportBatch {
  id                String            @id @default(cuid())
  organizationId    String
  bankAccountId     String
  fileName          String
  fileFormat        String            @default("CSV")
  totalRecords      Int               @default(0)
  importedRecords   Int               @default(0)
  skippedDuplicates Int               @default(0)
  status            ImportBatchStatus @default(PENDING)
  importedById      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([organizationId, bankAccountId])
  @@index([status])
}

// ============================================================================
// PHASE 7: EXPENSE MANAGEMENT & EMPLOYEE REIMBURSEMENTS
// ============================================================================

model ExpenseCategory {
  id                     String        @id @default(cuid())
  organizationId         String
  name                   String
  code                   String
  description            String?
  linkedExpenseAccountId String?
  taxRate                Float         @default(0.0)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedExpenseAccount Account?      @relation("ExpenseCategoryToAccount", fields: [linkedExpenseAccountId], references: [id], onDelete: SetNull)
  expenses             Expense[]
  lines                ExpenseLine[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([linkedExpenseAccountId])
}

model Expense {
  id                     String              @id @default(cuid())
  organizationId         String
  expenseNumber          String
  expenseType            ExpenseType         @default(DIRECT_BUSINESS)
  status                 ExpenseStatus       @default(DRAFT)
  paymentType            ExpensePaymentType  @default(PAID_IMMEDIATELY)
  expenseDate            DateTime
  dueDate                DateTime?
  description            String
  notes                  String?
  rejectionReason        String?
  currency               String              @default("USD")
  subtotal               Decimal             @default(0) @db.Decimal(15, 2)
  taxTotal               Decimal             @default(0) @db.Decimal(15, 2)
  total                  Decimal             @default(0) @db.Decimal(15, 2)
  claimantId             String?
  supplierId             String?
  categoryId             String?
  bankAccountId          String?
  journalEntryId         String?
  reimbursementJournalId String?
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  postedAt               DateTime?
  paidAt                 DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimant             User?              @relation("UserClaimedExpenses", fields: [claimantId], references: [id], onDelete: SetNull)
  supplier             Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category             ExpenseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankAccount          BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalEntry         JournalEntry?      @relation("ExpenseJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  reimbursementJournal JournalEntry?      @relation("ExpenseReimbursementJournal", fields: [reimbursementJournalId], references: [id], onDelete: SetNull)
  createdBy            User               @relation("UserCreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy           User?              @relation("UserApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)
  lines                ExpenseLine[]
  attachments          ExpenseAttachment[]

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, status])
  @@index([organizationId, expenseDate])
  @@index([organizationId, claimantId])
  @@index([supplierId])
  @@index([categoryId])
  @@index([bankAccountId])
  @@index([journalEntryId])
}

model ExpenseLine {
  id          String   @id @default(cuid())
  expenseId   String
  categoryId  String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(15, 4)
  unitPrice   Decimal  @default(0) @db.Decimal(15, 2)
  taxRate     Float    @default(0.0)
  subtotal    Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(15, 2)
  total       Decimal  @default(0) @db.Decimal(15, 2)
  notes       String?

  expense  Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@index([categoryId])
}

model ExpenseAttachment {
  id             String   @id @default(cuid())
  organizationId String
  expenseId      String
  fileName       String
  fileSize       Int
  mimeType       String
  storagePath    String
  hash           String?
  uploadedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense      Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("UserUploadedAttachments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, expenseId])
  @@index([expenseId])
}


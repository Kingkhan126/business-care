# ==============================================================================
# BIZENGINE APPLICATION PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or configure these variables in your
# deployment platform (Vercel, AWS, Cloudflare, Railway, etc.).
# NEVER commit .env files containing real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with SSL and connection pooling enabled.
# For serverless platforms (e.g. Vercel), use a pooled connection URI (PgBouncer/Neon/Supabase)
# Example: postgresql://username:password@pooler.neon.tech/bizengine_db?sslmode=require&connection_limit=10&pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# High-entropy cryptographic random key used to sign and verify HMAC-SHA256 session tokens.
# Minimum 32 characters required. Generate via: openssl rand -hex 32
AUTH_SECRET="generate-a-cryptographically-secure-32-character-secret"

# Node environment. Set to 'production' on live deployment hosts.
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & NETWORKING (RECOMMENDED)
# ------------------------------------------------------------------------------
# Canonical base URL of the deployed application.
# Used for absolute redirect generation, CORS validation, and email notification links.
APP_URL="https://app.yourdomain.com"

# Server listening port (default: 3000, managed automatically on Vercel/PaaS)
PORT="3000"

# ------------------------------------------------------------------------------
# 3. PERSISTENT OBJECT STORAGE (REQUIRED FOR SERVERLESS DEPLOYMENT)
# ------------------------------------------------------------------------------
# S3-compatible cloud storage for receipt attachments, documents, and corporate logos.
# Supports AWS S3, Cloudflare R2, MinIO, and Supabase Storage.
#
# Bucket name
S3_BUCKET="bizengine-production-storage"

# S3 Region (e.g. 'us-east-1', or 'auto' for Cloudflare R2)
S3_REGION="auto"

# Storage Access Key ID
S3_ACCESS_KEY_ID="your-storage-access-key-id"

# Storage Secret Access Key
S3_SECRET_ACCESS_KEY="your-storage-secret-access-key"

# Custom S3 Endpoint URL (Required for Cloudflare R2 and MinIO; omit for standard AWS S3)
# Cloudflare R2 Example: https://<accountid>.r2.cloudflarestorage.com
# MinIO Example: https://minio.yourdomain.com
S3_ENDPOINT=""

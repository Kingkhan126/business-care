# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/app_platform"

# Random 32+ character secret used to sign session JWTs.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the deployed app (used in links inside notifications, etc.)
APP_URL="http://localhost:3000"

# --- Not yet wired up (see README "Known limitations") ---

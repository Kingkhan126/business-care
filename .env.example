# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=

# Email credentials, once email notifications are implemented:
# EMAIL_FROM=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
